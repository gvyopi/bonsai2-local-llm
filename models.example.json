# ---------------------- 复制到项目目录即可用的示例配置 ----------------------
# 用法：把本文件改名为 models.json 放在项目根目录（与 llmctl.ps1 同级）。
# 路径写法：以 .\ 开头表示相对项目根目录；也可写绝对路径。
# %ENV% 形式会展开环境变量。

{
  "app": ".\\app",
  "logDir": ".\\logs",
  "ollamaExe": "%LOCALAPPDATA%\\Programs\\Ollama\\ollama.exe",

  "models": [
    {
      "key": "9b",
      "kind": "llama",
      "name": "Bonsai 2 9B",
      "file": ".\\models\\Ternary-Bonsai-2-9B-PQ2_0.gguf",
      "alias": "bonsai-2-9b",
      "port": 8080,
      "ctx": 131072,
      "maxCtx": 163840,
      "vram": 6592,
      "tiers": [
        { "ctx": 32768,  "vram": 3424, "use": "日常对话 + 工具调用" },
        { "ctx": 65536,  "vram": 4480, "use": "长文档摘要" },
        { "ctx": 131072, "vram": 6592, "use": "大代码库；推荐上限" },
        { "ctx": 163840, "vram": 7648, "use": "极限档" }
      ]
    },
    {
      "key": "27b",
      "kind": "llama",
      "name": "Bonsai 2 27B",
      "file": ".\\models\\Ternary-Bonsai-2-27B-PTQ1_0.gguf",
      "alias": "bonsai-2-27b",
      "port": 8081,
      "ctx": 32768,
      "maxCtx": 32768,
      "vram": 7832,
      "tiers": [
        { "ctx": 8192,  "vram": 6334, "use": "短问答" },
        { "ctx": 16384, "vram": 6854, "use": "不推荐：DSH 会截断" },
        { "ctx": 32768, "vram": 7832, "use": "DSH 唯一可用档" }
      ]
    }
  ]
}

# ---------------------- 字段说明 ----------------------
# key      : 命令行里用的短名（llmctl.ps1 start 9b）
# kind     : llama = 走 llama-server；ollama = 交给 Ollama 管理
# file     : llama 时是 gguf 路径；ollama 时是模型名（如 qwen3:8b-16k）
# alias    : 暴露给 OpenAI API 的 model 名，DSH 配置里的 id 要和它一致
# port     : 监听端口（只绑 127.0.0.1）
# ctx      : 默认上下文
# maxCtx   : 上限，-Ctx 超过会被截断到这里
# vram     : 该档位的显存估算（MiB），仅用于显示
# tiers    : 可选档位表，GUI 下拉框和 `llmctl.ps1 tiers <key>` 都读它